<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Title="Launcher" Height="576" Width="1080"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="Transparent">
    <Window.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="FontWeight"  Value="Normal"/>
            <Setter Property="FontSize"  Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border
                            Margin = "15, 2, -15, -2">
                            <Grid>
                                <Grid Height="30" Width="100">
                                    <Border x:Name="border"
                                            CornerRadius="11,11,0,0"
                                            Background="#FF0F0F2D"/>
                                </Grid>
                                <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FF181735" />
                                <Setter Property="FontWeight"
                                        Value="Normal"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FF181735" />
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="15" BorderBrush="Black" BorderThickness="0" Padding="0" Background="#FF181735">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="15, 15, 0, 0" BorderBrush="Black" BorderThickness="0" Padding="0" Background="#FF0F0F2D" Grid.ColumnSpan="2">
                <Grid Background="Transparent"
                      MouseDown="Grid_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UpdateLauncherButton" Grid.Column="15" Opacity="100" IsEnabled="false"
                            Click="UpdateLauncher_Click">
                        <Image Source="images/Download.png" Margin="2" RenderOptions.BitmapScalingMode="Fant"/>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF636363"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="20" Height="20"
                                    CornerRadius="13"
                                    Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="16" Content="-"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                            Click="Minimise_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="TextElement.FontFamily" Value="fonts/#Primer Print"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF636363"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="20" Height="20"
                                    CornerRadius="13"
                                    Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="17" Content="X"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                            Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="TextElement.FontFamily" Value="fonts/#Primer Print"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFB24B4B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="20" Height="20"
                                    CornerRadius="13"
                                    Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Image Source="images/CarpWhite.png" 
                           Margin="5, 5, 0, 5" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="Fant"/>

                    <TextBlock Text="MagicCarp Games" 
                       Foreground="White" 
                       Grid.Column="1" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontFamily="fonts/#Primer Print" 
                       FontWeight="Bold"
                       FontSize="16"/>

                    <!--<TextBlock Text="Menu" 
                       Foreground="LightGray" 
                       Grid.Column="2" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontFamily="fonts/#Primer Print" 
                       FontWeight="Medium"
                       FontSize="12"/>-->

                    <!--<TextBlock Text="Website" 
                       Foreground="LightGray" 
                       Grid.Column="2" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontFamily="fonts/#Primer Print" 
                       FontWeight="Medium"
                       FontSize="14"/>-->

                    <!--<Button Content="Website" 
                            Foreground="White" 
                            Grid.Column="2" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            FontFamily="fonts/#Primer Print" 
                            FontWeight="Medium"
                            FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="TextElement.FontFamily" Value="fonts/#Primer Print"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF181735"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Width="60" Height="22"
                                    CornerRadius="11"
                                    Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>-->
                </Grid>
            </Border>

            <Border Background="#FF0F0F2D" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="0, 0, 15, 15">
                <TabControl x:Name="TabControl1" 
                     Background="Transparent" 
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Margin="5"
                     ContentTemplate="{StaticResource MainTabControlTemplate}">

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <Label Content="{Binding name}" 
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   FontFamily="fonts/#primer print" 
                                   Foreground="White" 
                                   Background="Transparent"
                                   FontSize="14"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>

